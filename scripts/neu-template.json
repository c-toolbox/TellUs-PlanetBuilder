{
	"applicationId": "tellus-demo",
	"version": "1.0.0",
	"defaultMode": "window",
	"port": 0,
	"documentRoot": "/dist/web/",
	"url": "/",
	"enableServer": true,
	"enableNativeAPI": true,
	"tokenSecurity": "one-time",
	"logging": {
		"enabled": true,
		"writeToLogFile": false
	},
	"nativeAllowList": ["app.exit", "window.center"],
	"modes": {
		"window": {
			"title": "Tellus Demo",
			"width": 3840,
			"height": 2400,
			"minWidth": 1920,
			"minHeight": 1080,
			"fullScreen": true,
			"alwaysOnTop": false,
			"icon": "/src/public/icon.png",
			"enableInspector": true,
			"borderless": false,
			"maximize": false,
			"hidden": false,
			"resizable": true,
			"exitProcessOnClose": false,
			"useSavedState": false
		}
	},
	"cli": {
		"binaryName": "tellus-demo",
		"resourcesPath": "/dist/",
		"frontendLibrary": {
			"patchFile": "/src/index.html",
			"devUrl": "http://localhost:5173",
			"projectPath": "/"
		}
	}
}
