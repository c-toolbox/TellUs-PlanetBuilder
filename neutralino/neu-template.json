{
	"applicationId": "",
	"version": "",
	"defaultMode": "window",
	"port": 0,
	"documentRoot": "/dist/web/",
	"url": "/",
	"enableServer": true,
	"enableNativeAPI": true,
	"enableExtensions": true,
	"tokenSecurity": "one-time",
	"extensions": [
		{
			"id": "se.visualiseringscenter.tuio",
			"commandWindows": "\"${NL_PATH}\\extensions\\tuio-extension.exe\""
		}
	],
	"logging": {
		"enabled": true,
		"writeToLogFile": false
	},
	"nativeAllowList": [
		"app.exit",
		"app.broadcast",
		"extensions.dispatch",
		"extensions.getStats",
		"window.center"
	],
	"modes": {
		"window": {
			"title": "",
			"width": 1280,
			"height": 800,
			"minWidth": 800,
			"minHeight": 600,
			"fullScreen": false,
			"alwaysOnTop": false,
			"icon": "/icon.png",
			"enableInspector": false,
			"borderless": false,
			"maximize": false,
			"hidden": false,
			"resizable": true,
			"exitProcessOnClose": false,
			"useSavedState": false
		}
	},
	"cli": {
		"binaryName": "",
		"resourcesPath": "/dist/",
		"frontendLibrary": {
			"patchFile": "/src/index.html",
			"devUrl": "http://localhost:5173",
			"projectPath": "/"
		}
	}
}
